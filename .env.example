# ────────────────────────────────────────────────────────────
# MARIA — variáveis de ambiente (exemplo)
# Copie para `.env` e ajuste. Todas têm default em backend/config.py.
# Nenhum segredo aqui: o token do bridge é um ficheiro
# (frontend-tauri/shared/.bridge_token), gerado pelo backend.
# ────────────────────────────────────────────────────────────

# Ambiente de execução (development habilita CORS do Vite dev server)
MARIA_ENV=production

# llama-server
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=qwen2.5-omni-3b
LLAMA_TIMEOUT=300
LLAMA_NUM_CTX=4096
LLAMA_NUM_PREDICT=400

# Nota: existem ~30 parâmetros adicionais de sampler/limites em
# backend/config.py (LLAMA_TEMPERATURE_*, LLAMA_DRY_*, LLAMA_TOP_*,
# MAX_LINHAS_*, MAX_CHARS_LEITURA, LOG_LEVEL, PASTA_*, ...).
# Ver backend/config.py para a lista completa e os defaults.
