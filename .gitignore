```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE and editor configurations
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Lock files
package-lock.json
yarn.lock
Cargo.lock
Pipfile.lock

# Development specific
.nyc_output/
.coverage
.pytest_cache/
.mypy_cache/

# Tauri specific
frontend-tauri/node_modules/
frontend-tauri/target/
frontend-tauri/src-tauri/target/
```