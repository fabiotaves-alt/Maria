<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tristar.maria.ui.HeroController"
      styleClass="hero-section" spacing="20">

    <!-- Título + avatar -->
    <HBox alignment="CENTER_LEFT" spacing="24">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="MARIA" styleClass="hero-title"/>
            <Label text="Sua assistente de IA pessoal e privada."
                   styleClass="hero-subtitle"/>
        </VBox>
        
        <!-- Container do avatar com brilho e anel -->
        <StackPane styleClass="avatar-container">
            <Circle fx:id="avatarGlow" styleClass="avatar-glow" radius="90" />
            <Circle styleClass="avatar-ring" radius="90" />
            <ImageView fx:id="avatarImage" fitWidth="180" fitHeight="180" preserveRatio="true" styleClass="avatar-image">
                <image>
                    <Image url="@/com/tristar/maria/maria-avatar.png"/>
                </image>
            </ImageView>
        </StackPane>
    </HBox>

    <!-- 3 cards de funcionalidades -->
    <HBox spacing="16">
        <VBox styleClass="card-feature" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="🔒 Privacidade total" styleClass="card-title" wrapText="true"/>
            <Label text="100% local, sem nuvem, seus dados nunca saem da sua máquina."
                   styleClass="card-text" wrapText="true"/>
        </VBox>
        <VBox styleClass="card-feature" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="🧠 Inteligência local" styleClass="card-title" wrapText="true"/>
            <Label text="Raciocínio e inferência via LLM executado inteiramente offline."
                   styleClass="card-text" wrapText="true"/>
        </VBox>
        <VBox styleClass="card-feature" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="⚡ Pronta para ajudar" styleClass="card-title" wrapText="true"/>
            <Label text="Planilhas, documentos, análise de dados e conversa natural."
                   styleClass="card-text" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- 4 ações rápidas -->
    <VBox spacing="10">
        <Label text="O que você gostaria de fazer?" styleClass="card-title"/>
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <Button text="📄 Analisar Documento" styleClass="quick-action" onAction="#acaoAnalisarDocumento" maxWidth="Infinity" wrapText="true" GridPane.hgrow="ALWAYS"/>
            <Button text="📊 Analisar Dados" styleClass="quick-action" onAction="#acaoAnalisarDados" GridPane.columnIndex="1" maxWidth="Infinity" wrapText="true" GridPane.hgrow="ALWAYS"/>
            <Button text="✍️ Gerar Texto" styleClass="quick-action" onAction="#acaoGerarTexto" GridPane.rowIndex="1" maxWidth="Infinity" wrapText="true" GridPane.hgrow="ALWAYS"/>
            <Button text="🎤 Responder com Voz" styleClass="quick-action" onAction="#acaoResponderVoz" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" wrapText="true" GridPane.hgrow="ALWAYS"/>
        </GridPane>
    </VBox>
</VBox>