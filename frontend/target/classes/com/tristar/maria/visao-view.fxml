<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tristar.maria.ui.VisaoController" spacing="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="👁️ Visão" styleClass="titulo-aba"/>
    <Label text="Análise de imagens e reconhecimento visual" styleClass="subtitulo-aba"/>
    <ImageView fx:id="imagemPreview" fitHeight="300" preserveRatio="true"/>
    <Button text="Carregar Imagem" onAction="#carregarImagem"/>
    <Label fx:id="labelAnalise" text="Nenhuma imagem analisada" wrapText="true"/>
</VBox>
