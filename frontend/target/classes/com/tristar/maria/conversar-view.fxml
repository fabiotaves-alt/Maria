<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tristar.maria.ui.ConversarController"
      styleClass="chat-panel chat-panel-modern" prefWidth="380" minWidth="300">
    
    <!-- Adicione um padding geral para o painel flutuar -->
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <!-- Header do chat -->
    <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="8">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="CONVERSA ATUAL" styleClass="chat-title"/>
            <Label fx:id="labelStatus" text="●  online" styleClass="chat-sub"/>
        </VBox>
        <MenuButton text="⋯" styleClass="icon-btn">
            <items>
                <MenuItem text="Limpar Conversa" onAction="#limparConversa"/>
                <MenuItem text="Exportar Conversa (.txt)" onAction="#exportarConversa"/>
            </items>
        </MenuButton>
    </HBox>

    <!-- Área de mensagens -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-scroll chat-scroll-modern">
        <content>
            <VBox fx:id="areaMensagens" spacing="12" styleClass="chat-area"/>
        </content>
    </ScrollPane>

    <!-- Input -->
    <HBox styleClass="chat-input-row" alignment="CENTER" spacing="8">
        <Label fx:id="btnAnexar" text="📎" styleClass="icon-btn" onMouseClicked="#onAnexar"/>
        <TextField fx:id="campoMensagem" promptText="Digite sua mensagem..." onAction="#enviarMensagem"
                   HBox.hgrow="ALWAYS" styleClass="chat-field"/>
        <Label fx:id="btnVoz" text="🎤" styleClass="icon-btn" onMouseClicked="#onVoz"/>
        <Button text="➤" styleClass="send-btn" onAction="#enviarMensagem"/>
    </HBox>
</VBox>