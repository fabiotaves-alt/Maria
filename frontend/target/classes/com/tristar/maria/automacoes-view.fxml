<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tristar.maria.ui.AutomacoesController" spacing="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="⚙️ Automações" styleClass="titulo-aba"/>
    <Label text="Regras e gatilhos configuráveis para automação de tarefas" styleClass="subtitulo-aba"/>
    <ListView fx:id="listaAutomacoes" VBox.vgrow="ALWAYS"/>
    <Button text="Nova Automação" onAction="#novaAutomacao"/>
</VBox>
