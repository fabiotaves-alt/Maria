<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nyc.maria.ui.VozController" spacing="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="🎤 Voz" styleClass="titulo-aba"/>
    <Label text="Entrada e saída de áudio (STT/TTS)" styleClass="subtitulo-aba"/>
    <Button fx:id="btnGravar" text="🔴 Gravar Áudio" onAction="#iniciarGravacao"/>
    <Label fx:id="labelStatus" text="Pronto para gravar" styleClass="status"/>
    <TextArea fx:id="areaTranscricao" editable="false" promptText="Transcrição aparecerá aqui..." VBox.vgrow="ALWAYS"/>
</VBox>
