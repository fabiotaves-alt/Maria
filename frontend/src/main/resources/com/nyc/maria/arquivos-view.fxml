<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nyc.maria.ui.ArquivosController" spacing="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="📁 Arquivos" styleClass="titulo-aba"/>
    <Label text="Gerenciamento e análise de arquivos (planilhas, documentos)" styleClass="subtitulo-aba"/>
    <Button text="Selecionar Arquivo" onAction="#selecionarArquivo"/>
    <ListView fx:id="listaArquivos" VBox.vgrow="ALWAYS"/>
    <Label fx:id="labelStatus" text="Nenhum arquivo carregado" styleClass="status"/>
</VBox>
