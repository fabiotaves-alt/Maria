<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tristar.maria.ui.AnaliseDadosController" spacing="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="📊 Análise de Dados" styleClass="titulo-aba"/>
    <Label text="Análise estatística e insights de dados estruturados" styleClass="subtitulo-aba"/>
    <TextArea fx:id="areaResultado" editable="false" VBox.vgrow="ALWAYS" promptText="Resultados da análise aparecerão aqui..."/>
    <Label fx:id="labelStatus" text="Aguardando dados para análise" styleClass="status"/>
</VBox>
